  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Aantal ERPx berichten per zender, PROEF-zendingen uitgesloten.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "displayLabels": ["value"],
        "legend": {
          "displayMode": "list",
          "overflow": "ellipsis",
          "placement": "bottom",
          "showLegend": true,
          "values": []
        },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "sort": "desc",
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (zender) (\n  count_over_time(\n    {service_name=\"mule\"}\n    | json\n    | applicationName =~ \"planon-eapi|energiemissie-eapi|ltc-eapi|easyfunders-eapi|fis-nijm-eadap|power2pay-padap|fis-nijm-papi\"\n    | content_zender != \"\" and content_zender !~ \"(?i)PROEF\"\n    | label_format zender=content_zender\n    [$__range]\n  )\n)",
          "legendFormat": "{{zender}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "ERPx berichten per zender (excl. PROEF)",
      "type": "piechart"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Aantal correlation IDs met een ERROR, gegroepeerd per zender.",
      "fieldConfig": {
        "defaults": {
